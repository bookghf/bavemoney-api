# Copy to .env (git-ignored) and fill in every empty value. docker compose,
# `go run ./cmd/api`, and the integration tests all read .env; no credential
# has a default in the code.
#
#   cp .env.example .env
#   openssl rand -hex 32   # for JWT_SECRET
#   openssl rand -hex 24   # for POSTGRES_PASSWORD

# development (default) or production. Production refuses to start with a
# short JWT secret or database password, or with CORS "*".
APP_ENV=development
PORT=8080

# Database credentials, used by the Postgres container on first start.
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=

# How the API reaches Postgres from this machine (go run, integration tests).
# Docker compose builds its own URL from the POSTGRES_* values above.
DATABASE_URL=postgres://ledger:<POSTGRES_PASSWORD>@localhost:5432/ledger?sslmode=disable

# Signs access tokens. Changing it signs everyone out of their current access
# token (the app renews it with its refresh token).
JWT_SECRET=

# Comma-separated browser origins, or * for any (development only).
CORS_ALLOWED_ORIGINS=*

# Password reset emails go through Resend (https://resend.com). Leave the key
# empty in development to print each email (with its code) to the API log
# instead. Production refuses to start without both.
RESEND_API_KEY=
MAIL_FROM=Ledger <no-reply@example.com>
