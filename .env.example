# Copy to .env (git-ignored). docker compose reads it automatically.

# development (default) or production. Production refuses to start with the
# development password, a weak JWT secret, or CORS "*".
APP_ENV=development
PORT=8080

# Used by `go run ./cmd/api` outside Docker; compose builds its own URL.
DATABASE_URL=postgres://ledger:<db-password>@localhost:5432/ledger?sslmode=disable
POSTGRES_PASSWORD=<db-password>

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated browser origins, or * for any (development only).
CORS_ALLOWED_ORIGINS=*
